  "equivalence_argument": {
    "variables": "c = incumbent count, n = ceil(required/output), R = remaining executions",
    "bounded_arithmetic": "Stock is subtracted first. Entering this branch guarantees 1 <= required <= SAT-1 and 0 < exact output = long output < SAT; n fits long.",
    "grow": "When c < n, old growth produces n and rejects n > R before common propagation work.",
    "trim": "When c >= n, old trimming produces n; common propagation work must be charged before rejecting n > R.",
    "early_failure": "n > R && c < n",
    "charges": "Keep the route-retention charge(1) and common propagation charge(1 + original input slots) separate, including zero-input routes.",
    "changing_demand": "Recompute n for every proposal; no count or demand reuse is introduced."
  },
