  "change": {
    "production_added_lines": 4,
    "scope": "EXTEND_ROUTES only; expansion equals the first route of its own output group and has positive incumbent firings.",
    "reason": "The null expansion and its three exchanges were already attempted for the same pair. With the active first route, explicit growth chooses exactly the same producer and yields the same counts or arithmetic/material rejection.",
    "state": "No new list, scan, cache, workspace or sorting charge.",
    "semantic_change": "Remove these repeated attempts from candidate/work counts; remaining candidate order is unchanged. More distinct candidates can become reachable within the unchanged 64 candidate / existing shared work and probe limits.",
    "limits": "A local equivalence proof does not establish global non-regression: a newly reached established improvement can change the incumbent before additional neighborhoods run."
  },
  "behavioral_tests": {
    "count": 3,
    "cases": [
      "Preserve room for KEEP_NEW_BATCH within 64 candidates and independently replay 7 to 6 firings.",
      "Retain explicit growth of an inactive first supplier.",
      "Retain REPLACE_SECOND_OUTPUT for an already active first supplier, independently replaying 9 to 8 firings."
    ],
    "negative_controls": {
      "candidate": "3/3 pass",
      "baseline": "fails new bounded-reachability witness",
      "inactive_first_guard": "mutation rejected by behavioral test",
      "phase_guard": "mutation rejected by joint replacement test",
      "scope": "Standalone JUnit against frozen classes; deliberately invalid mutations exist only in external overlays."
    }
