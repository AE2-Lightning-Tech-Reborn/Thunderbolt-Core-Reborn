  "changes": {
    "upstream": "For an ordinary single-route demand, compute ceil(netRequired/output) directly. Keep the original retain fee, original input-slot propagation fees, and distinct grow-vs-trim execution-limit rejection order. Recompute every candidate demand; no suffix or geometry cache.",
    "terminal": "After accepting the established terminal result, try strictly fewer total executions using at most three original terminal route identities. Stable output/resource sort and a separate query envelope reduce the portfolio. Signed integer intervals certify fixed-depth pair/triple proposals before original-graph replay and the original objective."
  },
  "terminal_scope": {
    "distinct_original_target_routes": [
      17,
      64
    ],
    "resources": "Exactly two direct-stock raw keys; each route consumes a positive amount of both.",
    "target_stock": 0,
    "maximum_request_output_per_route_and_total_inputs_per_route": 256,
    "maximum_combined_original_raw_stock": 256,
    "incumbent_executions": [
      2,
      32
    ],
    "excluded": [
      "byproducts",
      "execution slots",
      "returned inputs",
      "remainders",
      "private/reusable stock",
      "input producers",
      "exact/legacy numeric disagreement"
    ],
    "limits": "Local work at most 4096 intersected with actual shared remaining work; original global probe allowance at most 32, at most one supplemental probe, and existing optional time scope. Local refusal is checked before shared callback. No global limit was increased.",
    "candidate_scope": "The supplemental pair/triple neighborhood is intentionally additional. The separate upstream 64-candidate cap is unchanged. At-most-three support is not a theorem about all terminal portfolios.",
    "failure": "Keep the already certified best on local/shared/probe refusal or optional deadline. External cancellation propagates. A declined search is not an infeasibility result."
  },
